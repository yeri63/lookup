# Initialize global variables.

script="lookup"
path="$HOME/Documents/DailyLog"
basePath="`echo $path | awk -F "/" '{ print "/"$2"/"$3 }'`"

block=6                         # Search window, ie. lines where multiple hits are ignored.
content=4                       # Number of content lines to display for each hit.
depth=100                       # Limit number of initial hits for faster results.
matches=5                       # Number of matches to display. (updated within Results function)

rows=$(tput lines)                                 # Terminal session screen height.
cols=$(tput cols)                                  # Terminal session screen width.
matches=$(( (rows - 8 ) / (7 + content) ))         # Calculate how many results will fit.

BOLD="$(tput bold)"             # Tagline
GREEN="$(tput setaf 2)"         # Content File path.
YELLOW="$(tput setaf 3)"        # Current page indicator color.
BLUE="$(tput setaf 4)"          # Content Title.
WHITE="$(tput setaf 7)"		      # Script tagline, stats, content, and page numbers.
NORM="$(tput setaf 9)"          # Reset to default color.

start=0				                  # CPU Start Time
finish=0			                  # CPU Finish/Stop Time
delta=0				                  # CPU Time for search.

files=0				                  # Total files found containing match.
results=0			                  # Total number of matches.

valid_keys=""			              # Search keys which have hits.

declare -a stop_words=( a able about across after all almost also am among an and any are as at be \
                        because been but by can cannot could did do does either else ever every \
                        for from get got had has have he her hers him his how however i if in into \
                        is it its just least let like likely may me might most must my neither no \
                        nor not of off often on only or other our own rather said say says she \
                        should since so some than that the their them then there these they this \
                        those to too us wants was we were what when where which while who whom why \
                        will with would yet you your )

tput civis                      # Make the cursor invisible.
cd "$path"			                # Run all commands from archive path.

