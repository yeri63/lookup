normalExit ()

# Normal exit from the script, resetting terminal colors and cursor position.

{
    # tput rmcup                                                # Restore terminal screen content.
    tput cnorm                                                  # Reset cursor to normal state.
    tput sgr0                                                   # Turn off all text effects.
    exit 0
}

# ------- --------- --------- --------- --------- --------- --------- --------- --------- ---------

resultsMenu ()

# Display the query result, showing the Title (date from Daily Log), shortened filepath, position
# within the file, and a short one paragraph excerpt.

{
    clearScreen

    printf "  About %'.f results in %s files (%0.3f seconds).\n" $results $files $delta
    printf "  Showing results for %s\n\n\n" "${valid_keys:1}" 

    for (( k=0; k!=matches && (j+k)<i; k++ )); do

        (( menuNumber = k + 1 ))
        (( queryIndex = j + k ))

        # Locate the date of the entry, scrolling back to the last date entry.

        day=`head -${indexes[queryIndex]} "$path/${filenames[queryIndex]}" | \
             grep -E "^Mon,|^Tue,|^Wed,|^Thu,|^Thr,|^Fri,|^Sat,|^Sun," | tail -1`

        printf "  %s%s. %s%s\n" $BLUE "$menuNumber" "$day" $NORM
        printf "     %s%s.../%s, line=%s%s\n\n" $GREEN "$basePath" \
               "${filenames[queryIndex]}" \
               "${indexes[queryIndex]}" $NORM

        # Extract $content lines from file, starting at queryIndex.

        (( end = ${indexes[queryIndex]} + $content - 1 ))

        # After cleanup, orphan control, and alignment, then indent and remove trailing blank lines.

        printf "%s" $WHITE
        head -$end "$path/${filenames[queryIndex]}" | tail -$content | \
            leftAlign | \
            bulletAlign $(( cols - 16 )) | \
            head -$content | \
            cleanupText | \
            orphanControl | \
            sed '1,$s/^/        /' | \
            sed '$ {/^[[:space:]]*$/d;}' 

        if (( ${#misses[queryIndex]} > 0 )); then
            printf "        %sMissing: %s%s\n" $YELLOW "${misses[queryIndex]}" $WHITE
        fi

        echo
        echo
    done

    progressBar
}

# ------- --------- --------- --------- --------- --------- --------- --------- --------- ---------

Results ()
{
    i=0					# monitor number of hit records.

    # Read search results to arrays for quick access.

    while read null filenames[$i] indexes[$i] misses[$i]; do
        (( i++ ))
    done < pass2.dat

    # Main report loop, used to quickly preview search hits via a simple menu.

    for (( j=0; j<i; j+=matches )); do
        resultsMenu

        while read -rsn1 keypress; do

            # Check for terminal window border changes.

            cols=$(tput cols)                               # Terminal session screen width.

            # If the screen rows have changed, restart the main report loop.

            if (( rows != $(tput lines) || cols != $(tput cols) )); then
                rows=$(tput lines)		  	    # Terminal session screen height.
                matches=$(( (rows - 8 ) / (6 + content) ))  # Calculate how many results will fit.
                j=0
                resultsMenu
            fi
 
            case "$keypress" in
                $'\x1b' )    		# process ESC sequence.
                    read -rsn1 tmp
                    if [[ "$tmp" == "[" ]]; then
                        read -rsn1 tmp

                        case "$tmp" in
                            5 ) # PgUp
                                continue;;

                            6 ) # PgDn
                                continue;;

                            A ) # Up
                                continue;;

                            B ) # Down
                                continue;;

                            C ) # Right
                                if (( j <= ( i - matches - 1) )); then
                                    break
                                fi;;

                            D ) # Left
                                if (( j > 0 )); then
                                    (( j -= $matches ))
                                    resultsMenu
                                    continue
                                fi;;
                        esac
                    fi
   
                    # Flush "stdin" with 0.1 sec timeout.
                    read -rsn5;;

               # Other one byte (char) cases.

                [123456789] ) # Menu Selection
                    if (( keypress <= k )); then
                        itemIndex=$(( j + keypress - 1 ))

                        # Display the entire article/node surrounding the matched text, 
                        # to include context and/or relevant notes.

                        pos=`head -${indexes[$itemIndex]} ${filenames[$itemIndex]} | \
                            grep -n '^--$' | tail -1 | sed 's/:.*//'`

                        # Generate new lineBreak string, matching the terminal width.

                        lineBreak=""
                        for (( k = 1; k < cols/3; k++ )); do
                            lineBreak="-- $lineBreak"
                        done

                        # Added so left and right terminal borders match.
                        (( newcols = cols - 2 ))

                        # Generate pattern for less to highlight search keys.
                        pattern=`echo $valid_keys | sed 's/ /|/g'`

                        tail -n +$(( $pos + 1 )) ${filenames[$itemIndex]} |\
                            sed "s/-- -- --/$lineBreak/" | \
                            awk '/^--[ ]*$/ {exit} {print}' | \
                            bulletAlign $(( cols - 4 )) | \
                            sed 's/^/  /' | \
                            sed '1s/^/'$WHITE'/' | \
                            less -cir -p $pattern 
               
                        resultsMenu
                    fi
                    continue;;

                $'\x0' ) # Next
                    if (( j <= ( i - matches - 1) )); then
                        break
                    fi;;

                b ) # Prev
                    if (( j > 0 )); then
                        (( j -= $matches ))
                        resultsMenu
                        continue
                    fi;;

                q ) # Quit
                    tput cup $rows 0				# Move cursor to bottom of screen.
                    normalExit;;
            esac
        done
    done
}

