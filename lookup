usage_error ()
{
    echo
    echo "Quickly locate a process, notes, or event in the past."
    echo "usage: $script [item1] [item2] [item3] ..."
    echo 
    normalExit
}

# ------- --------- --------- --------- --------- --------- --------- --------- --------- ---------

stop_word ()

# Remove stop words, ie common words, to eliminate excessive hits.

{
    my_key=$1

    if [ ${#my_key} == 1 ]; then
        return 0
    fi

    for word in ${stop_words[@]}; do
        if [ "$my_key" == "$word" ]; then
        return 0 
        fi
    done

    return 1
}

# ------- --------- --------- --------- --------- --------- --------- --------- --------- ---------

asterisk ()

# Creates new grep search string when asterisks were added to the key, to search for parts of a word 
# instead of whole words.

{
    my_key=$1

    if [[ $1 =~ "*". && $1 =~ ."*" ]]; then 
        echo ${my_key} | sed 's/*//g'
    
    elif [[ $1 =~ "*". ]]; then 
        echo ${my_key#?}"\b"

    elif [[ $1 =~ ."*" ]]; then 
        echo "\b"${my_key%?}

    else
        echo "\b"${my_key}"\b"
    fi
}

# =================================================================================================
#  Search algorithm and supporting functions.
# =================================================================================================

Search ()

# Search archive path for matching records containing search keys.

{
    echo
    echo -n "Searching..."

    start=$(date +"%s%N")

    # Find a matching key.

    files=""
    key="$1"

    while (( $# > 0 )); do
        # Throw out any keys which are stop words, to reduce false hits.
        if stop_word $key; then
            shift
            key="$1"
            continue
        fi

        # Abort for inital negate keys, since there is nothing to filter yet.
        if [[ $key == -* ]]; then
            echo
            echo "Your search scope was too broad."
            echo
            echo "Adjust the position of negative keys so that"
            echo "there is content from prior key search available"
            echo "to filter results."
            echo
            normalExit
        fi
         
        # Check for asterisks in key, and adjust grep search string accordingly.
        search=$(asterisk $key)

        # Create list of files with hits to generate quicker results.
        sum=0
    
        files="`grep -ic "$search" dailylog-*.txt | sort -r | \
            while IFS=":" read filename index; do
                (( sum += index ))
                if [ $index -gt 0 ]; then
                    echo $filename
                fi

                if [ $sum -gt $depth ]; then       # Limit the number of hits.
                    break
                fi
            done`"

        # If there were any hits, exit initial scan.
        if [[ ${#files} -gt 0 ]]; then
            break
        fi

        # Get next search key.
        shift
        key="$1"

        >&2 echo -n "."					                   # show progress during search.
    done

    # No match was found with any key. Update user and exit.
    if (( ${#files} == 0 )); then
        echo
        echo "Your search did not match any keys."
        echo
        echo "Suggestions:"
        echo
        echo "- Make sure all words are spelled correctly."
        echo "- Search parts of words by adding an asterisk."
        echo "- Try different keywords."
        echo "- Try more general keywords."
        echo
        normalExit
    fi

    # Process each key, saving each search result to pass1.dat.
    count=0

    # Re-init file used to collect key hit data.
    touch pass1.dat 
    rm pass1.dat 

    while (( $# > 0 )); do
        >&2 echo -n "."					                   # show progress during search.

        # Throw out any keys which are stop words, to reduce false hits.
        if stop_word $key; then
            shift
            key="$1"
            continue
        fi

        # Check for negate keys.
        if [[ $key == -* ]]; then

            # Locate indexes where hit(s) were found.
            for filename in $files; do

                # Count number of matches for negate key, sans the (-) prefix.
                neg_hits=`grep -ic ${key:1} $filename`

                if [[ $neg_hits -gt 0 ]]; then
                    grep -Hin ${key:1} $filename | \
                    awk -F ":" -v key=$key '
                            { filename = $1;
                              line = $2;
                              printf("%s %06d %s\n", filename, line, key); }' | sort -r >> pass1.dat

                    (( count += neg_hits ))
                fi
            done
        fi

        # Check for asterisks in key, and adjust grep search string accordingly.
        search=$(asterisk $key)

        # Locate indexes where hit(s) were found.
        for filename in $files; do

            # Count number of matches for current key.
            hits=`grep -ic $search $filename`

            if [[ $hits -gt 0 ]]; then
                grep -Hin "$search" $filename | \
                awk -F ":" -v key=$key '
                        { filename = $1;
                          line = $2;
                          printf("%s %06d %s\n", filename, line, key); }' | sort -r >> pass1.dat
            fi

            (( count += hits ))
        done

        # Record valid keys for report header.
        if [[ $count -gt 0 ]]; then
            valid_keys="$valid_keys $key" 
        fi

        shift						# get next search key.
        key=$1
    done

#exit -1

    # Generate a list without any negate keys.
    # pos_keys="`echo $valid_keys | sed 's/ /\n/g' | sed '/-/d'`"
    pos_keys="`echo $valid_keys | sed '/-/d'`"

    # Locate article boundries to determine which keys go together.
    for filename in $files; do
        grep -Hn '^--$' $filename | \
        awk -F ":" '
            { filename = $1;
              line = $2;
              printf("%s %06d --\n", filename, line) }' >> pass1.dat
    done 

#exit -1

    # Merge all of the search results together.
    sort -r -k1,1 -k2,2 pass1.dat > pass2.dat
    cp pass2.dat pass1.dat

#exit -1

    >&2 echo -e "\nRemoving duplicate hits..."

    # Collect key hits for each article, number of matching keys, and show which keys are missing.
    # If any negate keys are found, remove article. 
    # Remove the article boundries.
    cat pass1.dat | awk -v keys="$pos_keys" '

        BEGIN { hit = 0; neg = 0;
                n = split(keys, master, " ") }

        /--/  { if (hit == 1) { 

                  # Count the number of key hits.
                  count = 0;
                  key_list ="";

                  for (i=1; i <= n; i++)
                    if (index(keys, master[i]) == 0)
                      key_list = sprintf("%s %s", key_list, master[i]);
                    else
                      count++;

                  if (neg == 0)
                    printf("%d %s %6d%s\n", count, file, ndx, key_list); 

                  hit = 0 }

                neg = 0; }

        !/--/ { if (substr($3, 1, 1) == "-")
                  neg = 1;

                if (hit == 1) {
                  keys = sprintf("%s %s", keys, $3);
                  ndx = $2; }

                else {
                  file = $1; ndx = $2; keys = $3; hit = 1; } }' > pass2.dat  

    cp pass2.dat pass1.dat

    >&2 echo -e "Sorting results..."
    cat pass1.dat | sort -k1,1h -k2,2d -k3,3h | tail -r > pass2.dat

    # Collect stats and generate summary.

    files=`cat pass2.dat | awk '{ print $2 }' | sort | uniq | wc -l`
    results=`cat pass2.dat | wc -l`

    finish=$(date +"%s%N")
    delta=`echo "scale=3; ($finish-$start)/1000000000" | bc`
}

